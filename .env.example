# Canonical production origin (no path or trailing slash).
SITE_URL=https://www.pennyplus.com
# Set false on staging/preview deployments. Vercel previews are automatically noindex.
SITE_INDEXABLE=true

# Supabase project settings > API. Never put a secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Elevated Supabase Data API key, server only (never NEXT_PUBLIC_).
SUPABASE_SECRET_KEY=
# Personal Access Token: local management/migration scripts only, not Vercel runtime.
SUPABASE_ACCESS_TOKEN=

# Auth.js / single-tenant Microsoft Entra ID (server only).
# Generate a fresh AUTH_SECRET locally with a cryptographically secure generator.
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=
ENTRA_ACCESS_ROLE=Portal.Access
# Local: http://localhost:3000 ; Production: https://www.pennyplus.com
AUTH_URL=http://localhost:3000

# Used only by the explicitly invoked one-time seed script.
INITIAL_SUPERADMIN_TENANT_ID=
INITIAL_SUPERADMIN_OBJECT_ID=

# Dedicated Microsoft 365 mail app (Microsoft Graph application Mail.Send).
# Secrets stay on the server; sender and HR recipients are set in /admin/obavijesti.
M365_MAIL_TENANT_ID=
M365_MAIL_CLIENT_ID=
M365_MAIL_CLIENT_SECRET=

# Optional scheduler bearer secret for GET /api/internal/mail-worker.
CRON_SECRET=
