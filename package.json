{
  "name": "penny-plus-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "assets:team": "node scripts/prepare-team.mjs",
    "assets:team:refresh": "node scripts/prepare-team.mjs --refresh",
    "build": "next build",
    "start": "next start",
    "check": "node scripts/check-site.mjs && node scripts/check-theme.mjs",
    "check:db": "node scripts/check-supabase.mjs",
    "test:admin": "tsx --test tests/admin.test.ts tests/admin-date-time.test.ts tests/admin-entry-list.test.ts",
    "test:cms": "node --conditions=react-server --import tsx --test tests/cms.test.ts tests/upload-security.test.ts tests/recruitment-notifications.test.ts tests/microsoft-mail.test.ts tests/operational-cms.test.ts",
    "storage:setup": "node scripts/setup-content-storage.mjs",
    "content:import": "tsx scripts/import-legacy-content.mts",
    "test:team": "tsx --test tests/team.test.ts",
    "check:admin:http": "node scripts/check-admin-http.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "db:plan": "tsx scripts/admin-db.mts plan",
    "db:inspect": "tsx scripts/admin-db.mts inspect",
    "db:migrate": "tsx scripts/admin-db.mts migrate",
    "db:apply": "tsx scripts/admin-db.mts migrate --apply",
    "db:status": "tsx scripts/admin-db.mts status",
    "db:export": "tsx scripts/admin-db.mts export",
    "check:admin:db": "tsx scripts/check-admin-db.mts",
    "diagnose:admin": "tsx scripts/diagnose-admin.mts",
    "check:admin:session": "tsx scripts/check-admin-session.mts",
    "db:seed-superadmin": "tsx scripts/admin-db.mts seed",
    "db:seed-superadmin:apply": "tsx scripts/admin-db.mts seed --apply",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "fix": "npm run lint:fix && npm run format"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "jose": "6.2.13",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
